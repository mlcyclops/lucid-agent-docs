---
// Breadcrumbs above each page title, read from the sidebar tree, then Starlight's own title.
import Default from "@astrojs/starlight/components/PageTitle.astro";

type Entry =
  | { type: "link"; label: string; href: string; isCurrent: boolean }
  | { type: "group"; label: string; entries: Entry[] };

function trail(entries: Entry[], path: { label: string; href?: string }[] = []): { label: string; href?: string }[] | null {
  for (const e of entries) {
    if (e.type === "link") {
      if (e.isCurrent) return path;
    } else {
      const first = e.entries.find((x): x is Extract<Entry, { type: "link" }> => x.type === "link");
      const found = trail(e.entries, [...path, { label: e.label, href: first?.href }]);
      if (found) return found;
    }
  }
  return null;
}

const route = Astro.locals.starlightRoute;
const crumbs = route.entry.data.template === "splash" ? null : trail(route.sidebar as Entry[]);
---

{crumbs && (
  <nav class="crumbs" aria-label="Breadcrumbs">
    <ol>
      <li><a href="/">Home</a></li>
      {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>)}
    </ol>
  </nav>
)}
<Default />
