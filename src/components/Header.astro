---
// Starlight's header laid out as TL187's floating blurred pill bar (techlead187.com nav), in TL order:
// links, theme music, then Starlight's social icons and theme select. On phones the link moves into
// the menu footer (MobileMenuFooter.astro) and the music button stays next to the menu button.
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import ThemeMusic from "./ThemeMusic.astro";
import { PLUGINS_URL } from "./links";
---

<div class="tl-bar" id="tl-bar">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <div class="sl-flex print:hidden"><Search /></div>
  <div class="sl-flex print:hidden end-group">
    <a class="tl-navlink sl-hidden md:sl-flex" href={PLUGINS_URL}>Premium plugins</a>
    <ThemeMusic />
    <div class="sl-hidden md:sl-flex right-group">
      <div class="sl-flex social-icons"><SocialIcons /></div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

<script>
  // TL's .scrolled state: a denser bar with a shadow once the page moves.
  const bar = document.getElementById("tl-bar")!;
  const onScroll = () => bar.classList.toggle("scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  .tl-bar {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
    padding: 0 8px 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--nav-bg);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    transition: background .25s, border-color .25s, box-shadow .25s;
  }
  .tl-bar.scrolled {
    background: var(--nav-bg-s);
    border-color: var(--line-hi);
    box-shadow: 0 10px 34px var(--shadow);
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .end-group,
  .right-group,
  .social-icons {
    gap: 0.75rem;
    align-items: center;
  }
  .end-group {
    gap: 0.5rem;
  }
  .right-group {
    margin-inline-start: 0.25rem;
  }
  .social-icons::after {
    content: "";
    height: 2rem;
    border-inline-end: 1px solid var(--line);
  }

  /* Phones: Starlight's fixed menu button sits inside the bar's right end (custom.css moves it), so the
     bar spans the full width and keeps room for it: 8px inset + button + 8px gap. */
  @media (max-width: 49.99rem) {
    :global(:root[data-has-sidebar]) .tl-bar {
      padding-inline-end: calc(16px + var(--sl-menu-button-size));
    }
  }

  /* Starlight's header grid: the search box lines up with the content column. */
  @media (min-width: 50rem) {
    :global(:root[data-has-sidebar]) {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
    }
    :global(:root:not([data-has-toc])) {
      --__toc-width: 0rem;
    }
    .tl-bar {
      --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
      --__main-column-fr: calc(
        (
            100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
              (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
              var(--sl-content-width)
          ) / 2
      );
      display: grid;
      grid-template-columns:
        minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
        1fr
        auto;
      align-content: center;
    }
  }
</style>
