---
// Theme Music (techlead187.com, ADR-0038): note icon at rest, live equalizer while playing, a small
// list that pops below. Self-hosted tracks in public/audio; nothing downloads until a visitor presses play.
const play = '<svg class="play" viewBox="0 0 12 12"><path d="M3 1.5v9l7.5-4.5Z"/></svg>';
const stop = '<svg class="stop" viewBox="0 0 12 12"><rect x="2" y="2" width="8" height="8" rx="1.5"/></svg>';
const tracks = [
  { src: "/audio/mission-focus.mp3", name: "Mission Focus", len: "3:34" },
  { src: "/audio/night-shift.mp3", name: "Night Shift", len: "3:44" },
];
---

<div class="music" id="music">
  <button class="themebtn musicbtn" id="musicbtn" type="button" aria-label="Theme music" aria-haspopup="true" aria-expanded="false" aria-controls="musicpanel" title="Theme music">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <defs><linearGradient id="mus-grad" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#5b8cff" /><stop offset="1" stop-color="#3ee8f0" /></linearGradient></defs>
      <g class="mus-note"><path d="M9 17.5V6.2l10-2.2v11" /><circle cx="6.6" cy="17.6" r="2.4" /><circle cx="16.6" cy="15.1" r="2.4" /></g>
      <g class="mus-eq"><rect x="3.6" y="5" width="3" height="15" rx="1.5" /><rect x="8.6" y="5" width="3" height="15" rx="1.5" /><rect x="13.6" y="5" width="3" height="15" rx="1.5" /><rect x="18.6" y="5" width="3" height="15" rx="1.5" /></g>
    </svg>
  </button>
  <div class="music-pop" id="musicpanel" hidden>
    <div class="mp-head">Theme Music</div>
    {tracks.map((t) => (
      <button class="mp-track" type="button" aria-pressed="false" data-src={t.src}>
        <span class="mp-ico" aria-hidden="true" set:html={play + stop} />
        <span class="mp-name">{t.name}</span>
        <span class="mp-len">{t.len}</span>
      </button>
    ))}
  </div>
</div>

<style is:global>
  /* TL 316-341, verbatim apart from layout */
  .themebtn{flex:none; display:inline-grid; place-items:center; background:var(--glass); border:1px solid var(--line); color:var(--ink); width:42px; height:42px; border-radius:50%; cursor:pointer; transition:border-color .2s, background .2s}
  .themebtn:hover{border-color:var(--violet)}
  .music{position:relative; flex:none}
  .musicbtn svg{width:20px; height:20px; overflow:visible}
  .mus-note{fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; transform-origin:12px 13px; transition:opacity .25s, transform .25s}
  .musicbtn:hover .mus-note{transform:rotate(-8deg) translateY(-1px)}
  .mus-eq rect{fill:url(#mus-grad); transform-box:fill-box; transform-origin:center bottom; transform:scaleY(.35); opacity:0; transition:opacity .25s}
  .music.playing .mus-note{opacity:0; transform:scale(.6)}
  .music.playing .mus-eq rect{opacity:1; animation:mus-bar 1s ease-in-out infinite alternate}
  .music.playing .mus-eq rect:nth-child(2){animation-duration:.72s; animation-delay:-.3s}
  .music.playing .mus-eq rect:nth-child(3){animation-duration:.9s; animation-delay:-.55s}
  .music.playing .mus-eq rect:nth-child(4){animation-duration:.64s; animation-delay:-.15s}
  .music.playing .musicbtn{border-color:rgba(62,232,240,.55); box-shadow:0 0 18px rgba(62,232,240,.22)}
  @keyframes mus-bar{from{transform:scaleY(.3)} to{transform:scaleY(1)}}
  .music-pop{position:absolute; top:calc(100% + 10px); right:-4px; z-index:5; width:236px; padding:6px; border:1px solid var(--line-hi); border-radius:14px;
    background:var(--menu-bg); box-shadow:0 18px 44px var(--shadow); -webkit-backdrop-filter:blur(16px); backdrop-filter:blur(16px)}
  .music-pop[hidden]{display:none}
  .mp-head{padding:6px 10px 6px; font-size:11px; font-weight:600; letter-spacing:.09em; text-transform:uppercase; color:var(--faint)}
  .mp-track{display:flex; align-items:center; gap:10px; width:100%; padding:7px 10px 7px 7px; border:0; border-radius:10px; background:none; color:var(--dim);
    font:500 14px var(--sans); text-align:left; cursor:pointer; transition:background .15s, color .15s}
  .mp-track:hover{background:var(--glass-2); color:var(--ink)}
  .mp-track[aria-pressed="true"]{color:var(--hi); background:rgba(62,232,240,.08)}
  .mp-ico{flex:none; width:28px; height:28px; border-radius:50%; display:grid; place-items:center; border:1px solid var(--line-hi); color:var(--cyan)}
  .mp-track[aria-pressed="true"] .mp-ico{background:var(--grad); border-color:transparent; color:var(--on-grad)}
  .mp-ico svg{width:11px; height:11px; fill:currentColor}
  .mp-ico .stop,.mp-track[aria-pressed="true"] .mp-ico .play{display:none}
  .mp-track[aria-pressed="true"] .mp-ico .stop{display:block}
  .mp-name{flex:1; white-space:nowrap}
  .mp-len{font-size:12px; color:var(--faint); font-variant-numeric:tabular-nums}
  @media (prefers-reduced-motion:reduce){.music.playing .mus-eq rect{animation:none; transform:scaleY(.8)} .mus-note{transition:none}}
</style>

<script>
  // TL 2613-2640: Audio is created on first press; pressing the playing track stops it; a finished track
  // rolls to the next; outside click or Escape closes the list; no choice is stored.
  const music = document.getElementById("music")!;
  const musicBtn = document.getElementById("musicbtn")!;
  const musicPop = document.getElementById("musicpanel")!;
  const mtracks = [...music.querySelectorAll<HTMLButtonElement>(".mp-track")];
  let audio: HTMLAudioElement | null = null;
  let curTrack: HTMLButtonElement | null = null;

  function musicOpen(open: boolean) { musicPop.hidden = !open; musicBtn.setAttribute("aria-expanded", String(open)); }
  function musicSync() {
    const on = !!audio && !audio.paused;
    music.classList.toggle("playing", on);
    mtracks.forEach((t) => t.setAttribute("aria-pressed", String(on && t === curTrack)));
  }
  function musicPlay(t: HTMLButtonElement) {
    if (!audio) {
      audio = new Audio(); audio.preload = "none"; audio.volume = .6;
      ["play", "playing", "pause"].forEach((ev) => audio!.addEventListener(ev, musicSync));
      audio.addEventListener("ended", () => musicPlay(mtracks[(mtracks.indexOf(curTrack!) + 1) % mtracks.length]));
    }
    if (curTrack !== t) { audio.src = t.dataset.src!; curTrack = t; }
    const name = t.querySelector(".mp-name")!.textContent!;
    if ("mediaSession" in navigator && window.MediaMetadata) navigator.mediaSession.metadata = new MediaMetadata({ title: name, artist: "TECHLEAD 187", album: "Theme Music" });
    audio.play().catch(musicSync);
  }
  musicBtn.addEventListener("click", () => musicOpen(musicPop.hidden));
  mtracks.forEach((t) => t.addEventListener("click", () => {
    if (t === curTrack && audio && !audio.paused) audio.pause(); else musicPlay(t);
  }));
  document.addEventListener("click", (e) => { if (!musicPop.hidden && !music.contains(e.target as Node)) musicOpen(false); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !musicPop.hidden) { musicOpen(false); musicBtn.focus(); } });
</script>
